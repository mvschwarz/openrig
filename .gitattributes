# Skill-edge digests bind published bytes. Keep checkout text identical to Git
# on Windows too; auto detection preserves binary helper/assets verbatim.
skills/_canonical/** text=auto eol=lf
packages/daemon/specs/agents/shared/skills/** text=auto eol=lf
packages/daemon/assets/plugins/openrig-core/skills/** text=auto eol=lf
# The openrig bundle is a skill edge too: mirror-skills regenerates it and
# skill-edge-digests.generated.json records its bytes, so it needs the same pin.
packages/daemon/assets/plugins/openrig/skills/** text=auto eol=lf
# Built-in policy hashes attest the exact shipped authority bytes.
packages/daemon/policies/builtin/*.policy.md text eol=lf
# The thin startup overlay has a fixed size budget on every checkout.
packages/daemon/assets/guidance/openrig-start.md text eol=lf
packages/daemon/assets/guidance/openrig-seat-skills.md text eol=lf
# Keep the shebang at the script start for native Vite/Node import consumers.
packages/cli/scripts/check-abi.mjs text eol=lf
packages/daemon/scripts/gen-control-plane-json.mjs text eol=lf
# This file is the projection source for the shipped systematic-debugging helper: mirror-skills
# copies it into the spec edge verbatim, so a CRLF checkout would record Windows-only digests.
scripts/npm-command.mjs text eol=lf

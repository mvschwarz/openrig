@@ -0,0 +1,80 @@
+//! Isolated OpenRig env-file-v1 experiment against the pinned psmux tag.
+//! No values are serialized into server argv or control command text.
+use std::io::Read;
+
+pub const PREFIX: &str = "@openrig-env-v1:";
+pub const CAPABILITY: &str = "openrig-envfile-v1:new-session,respawn-pane";
+const MAX_BYTES: usize = 1024 * 1024;
+const ERROR: &str = "private environment file unavailable or invalid";
+
+#[derive(serde::Deserialize)]
+#[serde(deny_unknown_fields)]
+struct Manifest {
+    schema: String,
+    entries: Vec<(String, String)>,
+}
+
+fn decode(bytes: &[u8]) -> Result<Vec<(String, String)>, String> {
+    if bytes.len() > MAX_BYTES { return Err(ERROR.into()); }
+    let manifest: Manifest = serde_json::from_slice(bytes).map_err(|_| ERROR.to_string())?;
+    if manifest.schema != "openrig.psmux.environment/v1" { return Err(ERROR.into()); }
+    for (key, value) in &manifest.entries {
+        if !crate::util::is_valid_env_var_name(key) || value.contains('\0') { return Err(ERROR.into()); }
+    }
+    Ok(manifest.entries)
+}
+
+pub fn token(value: &str) -> Result<Vec<(String, String)>, String> {
+    if let Some(path) = value.strip_prefix(PREFIX) {
+        let file = std::fs::File::open(path).map_err(|_| ERROR.to_string())?;
+        if !file.metadata().map_err(|_| ERROR.to_string())?.is_file() { return Err(ERROR.into()); }
+        let mut bytes = Vec::new();
+        file.take((MAX_BYTES + 1) as u64).read_to_end(&mut bytes).map_err(|_| ERROR.to_string())?;
+        decode(&bytes)
+    } else {
+        crate::util::parse_new_session_e_value_token(Some(value)).map(|pair| vec![pair])
+    }
+}
+
+/// Preserve legacy respawn -e parsing and ordering; only the versioned invalid-
+/// assignment shape selects the new input. A malformed file is never ignored.
+pub fn respawn_values(args: &[&str]) -> Result<Vec<(String, String)>, String> {
+    let mut result = Vec::new();
+    let options = &args[..args.iter().position(|arg| *arg == "--").unwrap_or(args.len())];
+    for pair in options.windows(2).filter(|pair| pair[0] == "-e") {
+        if pair[1].starts_with(PREFIX) { result.extend(token(pair[1])?); }
+        else if let Some((key, value)) = pair[1].trim_matches('"').split_once('=') {
+            result.push((key.to_owned(), value.to_owned()));
+        }
+    }
+    Ok(result)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn private_env_preserves_literal_values_and_order() {
+        let entries = vec![("KEY", ""), ("KEY", " spaces \r\n中文#{session_name}\"\\$ ")];
+        let bytes = serde_json::to_vec(&serde_json::json!({"schema":"openrig.psmux.environment/v1","entries":entries})).unwrap();
+        assert_eq!(decode(&bytes).unwrap(), entries.into_iter().map(|(k,v)|(k.into(),v.into())).collect::<Vec<_>>());
+        assert_eq!(token("KEY=value").unwrap(), vec![("KEY".into(), "value".into())]);
+    }
+    #[test]
+    fn private_env_rejects_invalid_input_without_echoing_values() {
+        for value in [
+            serde_json::json!({"schema":"wrong","entries":[]}),
+            serde_json::json!({"schema":"openrig.psmux.environment/v1","entries":[["BAD-KEY","synthetic-secret"]]}),
+            serde_json::json!({"schema":"openrig.psmux.environment/v1","entries":[["KEY","synthetic\u{0}secret"]]}),
+            serde_json::json!({"schema":"openrig.psmux.environment/v1","entries":[],"extra":"synthetic-secret"}),
+        ] { assert_eq!(decode(&serde_json::to_vec(&value).unwrap()).unwrap_err(), ERROR); }
+        assert_eq!(decode(&vec![b'x'; MAX_BYTES + 1]).unwrap_err(), ERROR);
+        assert_eq!(decode(b"invalid synthetic-secret").unwrap_err(), ERROR);
+        assert_eq!(token("@openrig-env-v1:missing-file").unwrap_err(), ERROR);
+    }
+    #[test]
+    fn private_env_keeps_plain_respawn_order() {
+        assert_eq!(respawn_values(&["-e","KEY=first","-e","KEY=last"]).unwrap(), vec![("KEY".into(),"first".into()),("KEY".into(),"last".into())]);
+        assert_eq!(respawn_values(&["-e","KEY=first","--","node","-e","@openrig-env-v1:missing"]).unwrap(), vec![("KEY".into(),"first".into())]);
+    }
+}

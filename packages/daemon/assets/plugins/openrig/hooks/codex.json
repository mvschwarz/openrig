{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${OPENRIG_NODE:-node}\" \"${PLUGIN_ROOT}/hooks/scripts/claude-hook-bridge.cjs\" codex-start",
            "async": true,
            "timeout": 30
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "exec \"${OPENRIG_NODE:-node}\" \"${PLUGIN_ROOT}/hooks/scripts/claude-hook-bridge.cjs\" codex-end",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
